{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    }
  },
  "name": "@trebired/e-shop",
  "version": "0.3.0",
  "description": "E-shop for Bun apps: catalog, stock, cart, checkout, orders, payments, a storefront structure for @trebired/frontend and a signed admin API.",
  "type": "module",
  "private": false,
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client/index.js",
      "types": "./dist/client/index.d.ts"
    },
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./react": {
      "import": "./dist/react/index.js",
      "types": "./dist/react/index.d.ts"
    },
    "./server": {
      "import": "./dist/server/index.js",
      "types": "./dist/server/index.d.ts"
    }
  },
  "files": [
    ".trebired/logger/config.ts",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "bun run prepare:generated && rm -rf dist && tsc -p tsconfig.build.json && bun ./scripts/prepare-dist.mjs prepare-dist",
    "postpack": "bun ./scripts/prepare-dist.mjs postpack",
    "prepack": "bun run build && bun ./scripts/prepare-dist.mjs prepack",
    "prepublishOnly": "bun run typecheck && bun run build && bun run verify:pack && bun run verify:server && bun run verify:gateways && bun run verify:packeta && bun run verify:react",
    "prepare:generated": "bun ./scripts/build/generated/tsconfig.mjs",
    "typecheck": "bun run prepare:generated && tsc --noEmit",
    "verify:gateways": "bun ./scripts/verify/gateways.mjs",
    "verify:pack": "bun ./scripts/verify/pack.mjs",
    "verify:packeta": "bun ./scripts/verify/packeta.mjs",
    "verify:react": "bun ./scripts/verify/react.mjs",
    "verify:server": "bun ./scripts/verify/server.mjs"
  },
  "dependencies": {
    "@package/logger-adapter": "npm:@trebired/logger-adapter@^0.8.5",
    "@trebired/utils": "^0.9.9",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@trebired/frontend": "^30.2.0",
    "react": "^19.2.0"
  },
  "peerDependenciesMeta": {
    "@trebired/frontend": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@trebired/code-discipline": "^8.0.3",
    "@trebired/configs": "^0.9.0",
    "@trebired/frontend": "^30.2.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "e-shop",
    "ecommerce",
    "checkout",
    "orders",
    "payments",
    "postgres",
    "bun"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Trebired/e-shop"
  },
  "homepage": "https://github.com/Trebired/e-shop#readme",
  "bugs": {
    "url": "https://github.com/Trebired/e-shop/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
