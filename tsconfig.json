{
  "compilerOptions": {
    "allowJs": false,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "types": [
      "node",
      "bun"
    ]
  },
  "exclude": [
    "node_modules"
  ],
  "extends": "./.trebired/code-discipline/generated/tsconfig.paths.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    ".trebired/**/*.ts",
    "scripts/**/*.ts"
  ]
}
